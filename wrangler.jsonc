// kindlingspark.app on Cloudflare Workers. Deployed by .github/workflows/deploy.yml on pushes to main,
// or by hand with `npm run deploy`. Setup steps (D1 database, email, secrets): docs/PRESETS.md.
//
// dist/ (tools/build.js) holds the landing page, the user guide at /guide/ and the presets hub
// pages. worker/index.js runs only for /api/* (the presets API) and www redirects.
{
  "name": "kindling-control-website",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "kindlingspark.app", "custom_domain": true },
    { "pattern": "www.kindlingspark.app", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kindling-presets",
      // Replace with the id printed by `npx wrangler d1 create kindling-presets`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Cloudflare Email Service sends the sign-in links. Uncomment once kindlingspark.app is
  // onboarded to Email Service (or set the RESEND_API_KEY secret instead).
  // "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "SITE_ORIGIN": "https://kindlingspark.app",
    "MAIL_FROM": "KindlingControl <presets@kindlingspark.app>"
  },
  // Secrets (npx wrangler secret put …): ADMIN_EMAILS (moderators, comma-separated),
  // IP_HASH_SALT (any random string), and RESEND_API_KEY if you use Resend.
  "triggers": { "crons": ["17 4 * * *"] },
  "observability": { "enabled": true }
}
